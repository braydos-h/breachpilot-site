{
  "name": "breachpilot-site",
  "version": "0.1.0",
  "private": true,
  "description": "Official public website for BreachPilot — breachpilot.dev",
  "scripts": {
    "prebuild": "node scripts/sync-docs.mjs && node scripts/generate-meta.mjs && node scripts/generate-security-txt.mjs",
    "gen:meta": "node scripts/generate-meta.mjs",
    "gen:security-txt": "node scripts/generate-security-txt.mjs",
    "sync": "node scripts/sync-docs.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
